# Pusula AI — ortam değişkenleri
# Kullanım:  cp .env.example .env   ve token'ı yapıştır.
# ÖNEMLİ: Anahtar boş kaldığı sürece uygulama güvenle MOCK modda çalışır.
#         Video çekiminde canlı hata riski olmaması için bu kasıtlıdır.

# ─────────────────────────────────────────────────────────────────────
# LLM SAĞLAYICI
# ─────────────────────────────────────────────────────────────────────
# Varsayılan: GitHub Models (ücretsiz, OpenAI-uyumlu).
# github.com/settings/tokens adresinden bir PAT oluşturup buraya yapıştır.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://models.github.ai/inference

# Model registry — GitHub Models id biçimi "openai/" önekli
OPENAI_MODEL_LEADER=openai/gpt-4o             # lider ajan: delegasyon + sentez
OPENAI_MODEL_PLANNER=openai/gpt-4o            # itinerary_architect: en güçlü
OPENAI_MODEL_SPECIALIST=openai/gpt-4o-mini    # diğer uzman ajanlar
OPENAI_MODEL_CLASSIFIER=openai/gpt-4o-mini    # karmaşıklık sınıflandırıcı (yol seçimi)
OPENAI_EMBED_MODEL=openai/text-embedding-3-small

# GERÇEK OpenAI'ya geçmek istersen: OPENAI_BASE_URL satırını boş bırak ve
# model id'lerinden "openai/" önekini kaldır. Kodda başka değişiklik gerekmez.

GEN_TEMPERATURE=0.2       # düşük = deterministik/stabil yanıt

# Embedding'ler varsayılan olarak yerel/mock (ücretsiz sağlayıcı kotasını korur).
# Gerçek embedding istenirse: true
USE_REMOTE_EMBEDDINGS=false

# ─────────────────────────────────────────────────────────────────────
# REDIS  (oturum + vektör arama + cache)
# ─────────────────────────────────────────────────────────────────────
# Vektör arama RediSearch gerektirir -> docker compose up -d (redis/redis-stack)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=auto            # auto | true | false   (auto: erişilemezse in-memory'ye düşer)

# ─────────────────────────────────────────────────────────────────────
# CACHE / TTL  (saniye) — tazelik vs hız dengesi, bkz. PLAN.md §5
# ─────────────────────────────────────────────────────────────────────
SEMANTIC_THRESHOLD=0.92
SEMANTIC_TTL=3600
TTL_WEATHER=3600          # 1 saat
TTL_FX=3600               # 1 saat
TTL_FLIGHT_SEARCH=900     # 15 dakika
TTL_HOTEL_SEARCH=1800     # 30 dakika
TTL_POI=86400             # 24 saat
TTL_VISA=86400            # 24 saat + olay-tabanlı invalidation
TTL_DEST_BRIEF=604800     # 7 gün
SESSION_TTL=1800          # 30 dakika sliding

# ─────────────────────────────────────────────────────────────────────
# KVKK
# ─────────────────────────────────────────────────────────────────────
# Kişiselleştirme rızası olmadan profil YAZILMAZ. Bu bayrak yalnızca demo
# kolaylığı içindir; prod'da rıza her zaman kullanıcıdan alınır.
DEFAULT_PERSONALIZATION_CONSENT=false
AUDIT_LOG_ENABLED=true
